/// Repository calendar sample: 24 dates in 2026, the first and fifteenth of each month.
table DimDate
	lineageTag: 6952c039-dc91-45ef-aeb9-87fb1d50fb0f
	dataCategory: Time

	column DateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: DateKey

	column Date
		dataType: dateTime
		isUnique
		formatString: yyyy-MM-dd
		sourceColumn: Date

	column CalendarYear
		dataType: int64
		sourceColumn: CalendarYear

	column Quarter
		dataType: string
		sourceColumn: Quarter

	column MonthNumber
		dataType: int64
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	partition DimDate = entity
		mode: directLake
		source
			entityName: dimdate
			schemaName: dbo
			expressionSource: 'DirectLake - InsurancePolicySalesAndClaimsLH'

