/// Fact grain: one policy issuance or renewal transaction. Premium and commission amounts are transaction-level.
table FactPolicySales
	lineageTag: 5434a167-d419-4981-932b-225a380d1309

	/// Sum of annualized written premium for policy transactions.
	measure 'Total Premium' = SUM(FactPolicySales[AnnualPremium])
		formatString: $#,##0.00
		lineageTag: 6035c9f4-5aa5-4495-85da-ab07e7b7b23c

	/// Sum of agent commissions on policy transactions.
	measure 'Total Commission' = SUM(FactPolicySales[CommissionAmount])
		formatString: $#,##0.00
		lineageTag: 83a4fe8d-4e48-4a52-9292-ff6d1aa48a43

	/// Count of policy issuance and renewal transactions.
	measure 'Policy Transactions' = COUNTROWS(FactPolicySales)
		formatString: #,##0
		lineageTag: 242d7dc2-593d-40e6-8e8a-3325172c5fbf

	/// Average annual premium per policy transaction.
	measure 'Average Premium' = DIVIDE([Total Premium], [Policy Transactions])
		formatString: $#,##0.00
		lineageTag: 24db70b6-2abd-4ed5-9da7-b590dc41ec21

	/// Sum of coverage amounts represented by policy transactions.
	measure 'Total Coverage' = SUM(FactPolicySales[CoverageAmount])
		formatString: $#,##0.00
		lineageTag: 32477002-c431-4a11-8cc3-0af647161581

	/// Commission as a percentage of annual premium.
	measure 'Commission Rate' = DIVIDE([Total Commission], [Total Premium])
		formatString: 0.00%
		lineageTag: 68aaf791-66c7-4247-a573-368a8a1add1e

	/// Count of new policy issuance transactions.
	measure 'New Policies' = CALCULATE([Policy Transactions], FactPolicySales[TransactionType] = "New")
		formatString: #,##0
		lineageTag: 54cfe650-35ce-487d-a6d3-4c00708018c7

	column PolicySaleKey
		dataType: int64
		summarizeBy: none
		sourceColumn: PolicySaleKey

	column PolicyNumber
		dataType: string
		sourceColumn: PolicyNumber

	column SaleDateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: SaleDateKey

	column AgentKey
		dataType: int64
		summarizeBy: none
		sourceColumn: AgentKey

	column CustomerKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CustomerKey

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ProductKey

	column CarrierKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CarrierKey

	column AnnualPremium
		dataType: decimal
		formatString: $#,##0.00
		sourceColumn: AnnualPremium

	column CoverageAmount
		dataType: decimal
		formatString: $#,##0.00
		sourceColumn: CoverageAmount

	column CommissionAmount
		dataType: decimal
		formatString: $#,##0.00
		sourceColumn: CommissionAmount

	column PolicyStatus
		dataType: string
		sourceColumn: PolicyStatus

	column TransactionType
		dataType: string
		sourceColumn: TransactionType

	partition FactPolicySales = entity
		mode: directLake
		source
			entityName: factpolicysales
			schemaName: dbo
			expressionSource: 'DirectLake - InsurancePolicySalesAndClaimsLH'

