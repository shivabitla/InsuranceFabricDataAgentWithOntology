/// Policyholder/customer dimension.
table DimCustomer
	lineageTag: f305a991-6b0f-4408-a7de-26b247478a05

	column CustomerKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CustomerKey

	column CustomerID
		dataType: string
		sourceColumn: CustomerID

	column CustomerName
		dataType: string
		sourceColumn: CustomerName

	column Phone
		dataType: string
		sourceColumn: Phone

	column Address
		dataType: string
		sourceColumn: Address

	column State
		dataType: string
		sourceColumn: State

	column Region
		dataType: string
		sourceColumn: Region

	partition DimCustomer = entity
		mode: directLake
		source
			entityName: dimcustomer
			schemaName: dbo
			expressionSource: 'DirectLake - InsurancePolicySalesAndClaimsLH'

