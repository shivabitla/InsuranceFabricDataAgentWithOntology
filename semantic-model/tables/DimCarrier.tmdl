/// Insurance carrier/underwriter dimension.
table DimCarrier
	lineageTag: daf6813b-e3cb-44b6-b406-d4760fc85372

	column CarrierKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CarrierKey

	column CarrierID
		dataType: string
		sourceColumn: CarrierID

	column CarrierName
		dataType: string
		sourceColumn: CarrierName

	column AMBestRating
		dataType: string
		sourceColumn: AMBestRating

	column HeadquartersState
		dataType: string
		sourceColumn: HeadquartersState

	partition DimCarrier = entity
		mode: directLake
		source
			entityName: dimcarrier
			schemaName: dbo
			expressionSource: 'DirectLake - InsurancePolicySalesAndClaimsLH'

