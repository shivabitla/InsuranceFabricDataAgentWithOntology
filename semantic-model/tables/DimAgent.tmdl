/// Insurance sales agent dimension.
table DimAgent
	lineageTag: 87fec9fe-3475-479a-92d1-4a11b9184447

	column AgentKey
		dataType: int64
		summarizeBy: none
		sourceColumn: AgentKey

	column AgentID
		dataType: string
		sourceColumn: AgentID

	column AgentName
		dataType: string
		sourceColumn: AgentName

	column AgentLocation
		dataType: string
		sourceColumn: AgentLocation

	partition DimAgent = entity
		mode: directLake
		source
			entityName: dimagent
			schemaName: dbo
			expressionSource: 'DirectLake - InsurancePolicySalesAndClaimsLH'

