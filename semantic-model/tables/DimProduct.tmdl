/// Insurance product and line-of-business dimension.
table DimProduct
	lineageTag: 871ecc9d-94ba-4019-919c-faf9c37d7df9

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ProductKey

	column ProductID
		dataType: string
		sourceColumn: ProductID

	column ProductName
		dataType: string
		sourceColumn: ProductName

	column ProductCategory
		dataType: string
		sourceColumn: ProductCategory

	partition DimProduct = entity
		mode: directLake
		source
			entityName: dimproduct
			schemaName: dbo
			expressionSource: 'DirectLake - InsurancePolicySalesAndClaimsLH'

