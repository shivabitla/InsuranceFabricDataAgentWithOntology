/// One current claim record with cumulative paid amount and outstanding reserve. PolicyNumber is traceability, not a fact-to-fact relationship.
table FactClaims

	column ClaimKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ClaimKey

	column ClaimNumber
		dataType: string
		sourceColumn: ClaimNumber

	column PolicyNumber
		dataType: string
		sourceColumn: PolicyNumber

	column LossDateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: LossDateKey

	column ReportedDateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ReportedDateKey

	column AgentKey
		dataType: int64
		summarizeBy: none
		sourceColumn: AgentKey

	column CustomerKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CustomerKey

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ProductKey

	column CarrierKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CarrierKey

	column ClaimType
		dataType: string
		sourceColumn: ClaimType

	column ClaimStatus
		dataType: string
		sourceColumn: ClaimStatus

	column ClaimedAmount
		dataType: decimal
		formatString: $#,##0.00
		sourceColumn: ClaimedAmount

	column PaidAmount
		dataType: decimal
		formatString: $#,##0.00
		sourceColumn: PaidAmount

	column OutstandingReserve
		dataType: decimal
		formatString: $#,##0.00
		sourceColumn: OutstandingReserve

	partition FactClaims = entity
		mode: directLake
		source
			entityName: factclaims
			schemaName: dbo
			expressionSource: 'DirectLake - InsurancePolicySalesAndClaimsLH'
